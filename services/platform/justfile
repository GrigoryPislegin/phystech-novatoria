set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]
set dotenv-load := true

dev-server:
    uv run python3 -m nanimai_platform server

dev-llm-worker:
    uv run python3 -m nanimai_platform llm_worker

scan:
    snyk test

install:
    uv sync

deploy:
    rsync -r --info=progress2 -ahv . \
        --filter=':- .gitignore' \
        --exclude=".git" \
        ${SSH_TARGET}:${SSH_TARGET_PATH}

remote-execute *cmd:
    ssh ${SSH_TARGET} "cd ${SSH_TARGET_PATH} && {{ cmd }}"

remote-logs service="platform_server" tail="50":
    ssh ${SSH_TARGET} "cd ${SSH_TARGET_PATH} && docker compose logs --no-log-prefix --tail {{ tail }} {{ service }}" | jlf

grpc-server:
    just grpc-server-{{ os() }}

grpc-server-linux:

grpc-server-macos:
    rm -rf platform_api
    mkdir -p platform_api
    docker run --rm -v ./platform_api:/platform_api:rw -v ./api:/api:ro -w / \
        ghcr.io/astral-sh/uv:python3.13-bookworm-slim \
            uv run --with protoletariat==3.3.10,grpclib[protobuf]==0.4.9,mypy-protobuf==3.7.0,grpcio_tools==1.71.2 \
                protol --in-place --create-package --python-out platform_api \
                protoc --protoc-path="python3 -m grpc_tools.protoc" \
                    --proto-path=api --python_out=. --grpclib_python_out=. --mypy_out=. \
                        platform_api/v1/common.proto \
                        platform_api/v1/candidate_api.proto \
                        platform_api/v1/criterion_api.proto \
                        platform_api/v1/project_api.proto \
                        platform_api/v1/stop_factor_api.proto \
                        platform_api/v1/user_profile_api.proto \
                        platform_api/v1/vacancy_api.proto

grpc-server-windows:
    Remove-Item -Recurse -Force .\platform_api
    mkdir -p platform_api
    docker run --rm -v .\\platform_api:/platform_api:rw -v .\\api:/api:ro -w / \
        ghcr.io/astral-sh/uv:python3.13-bookworm-slim \
            uv run --with protoletariat==3.3.10,grpclib[protobuf]==0.4.9,mypy-protobuf==3.7.0,grpcio_tools==1.71.2 \
                protol --in-place --create-package --python-out platform_api \
                protoc --protoc-path="python3 -m grpc_tools.protoc" \
                    --proto-path=api --python_out=. --grpclib_python_out=. --mypy_out=. \
                        platform_api/v1/common.proto \
                        platform_api/v1/candidate_api.proto \
                        platform_api/v1/criterion_api.proto \
                        platform_api/v1/project_api.proto \
                        platform_api/v1/stop_factor_api.proto \
                        platform_api/v1/user_profile_api.proto \
                        platform_api/v1/vacancy_api.proto

grpc-clients:
    rm -rf nanimai_platform/external_clients
    mkdir -p nanimai_platform/external_clients

    uv run scripts/protogen.py \
        --what client \
        --repo git@github.com:nanimai-team/rocketdoc.git \
        --hash v1.1.0 \
        --path proto/resume_service.proto \
        --incl proto \
        --cmpl betterproto2 \
        --outd nanimai_platform/external_clients/rocketdoc_api

    uv run scripts/protogen.py \
        --what client \
        --repo git@github.com:nanimai-team/casino.git \
        --hash v0.4.0 \
        --path casino/cmd/server/grpc/balance.proto \
        --incl . \
        --cmpl betterproto2 \
        --outd nanimai_platform/external_clients/casino

    uv run scripts/protogen.py \
        --what client \
        --repo git@github.com:nanimai-team/tulpa.git \
        --hash v1.3.0 \
        --path api/tulpa_api/v1/common.proto \
        --path api/tulpa_api/v1/delayed_api.proto \
        --path api/tulpa_api/v1/messages.proto \
        --path api/tulpa_api/v1/urgent_api.proto \
        --incl api \
        --cmpl betterproto2 \
        --outd nanimai_platform/external_clients/tulpa

    uv run scripts/protogen.py \
        --what client \
        --repo git@github.com:nanimai-team/hharon.git \
        --hash d7b8f501b4a5035750453c29d026257103f3521b \
        --path api/hharon_api/v1/hharon.proto \
        --path api/hharon_api/v1/headhunter.proto \
        --incl api \
        --cmpl betterproto2 \
        --outd nanimai_platform/external_clients/hharon
